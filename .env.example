# TravClan sandbox credentials
#
# Copy this file to `.env` and fill in your own credentials from
# https://sandbox.travclan.com
#
# Create React App only exposes environment variables prefixed with REACT_APP_.
# Never commit a filled-in copy of this file: `.env` is in .gitignore.
#
# These values were previously hardcoded in App.jsx and committed to a public
# repository. They have been moved here so they cannot leak again.

REACT_APP_TRAVCLAN_MERCHANT_ID=
REACT_APP_TRAVCLAN_USER_ID=
REACT_APP_TRAVCLAN_API_KEY=